rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for valid document IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAccount(data) {
      return data.id is string &&
        data.username is string && data.username.size() <= 128 &&
        data.password is string && data.password.size() <= 128 &&
        data.role in ['admin', 'principal', 'teacher'] &&
        data.schoolName is string && data.schoolName.size() <= 300 &&
        data.status in ['active', 'suspended'];
    }

    function isValidPaper(data) {
      return data.id is string &&
        data.createdAt is string;
    }

    function isValidDateSheet(data) {
      return data.id is string &&
        data.examType is string &&
        data.classLevel is string;
    }

    function isValidMarksheet(data) {
      return data.id is string &&
        data.classLevel is string &&
        data.session is string;
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // School and Admin User Accounts
    match /accounts/{accountId} {
      allow read: if isValidId(accountId);
      allow create: if isValidId(accountId) && isValidAccount(incoming());
      allow update: if isValidId(accountId) && isValidAccount(incoming());
      allow delete: if isValidId(accountId);
    }

    // Examination Papers
    match /papers/{paperId} {
      allow read: if isValidId(paperId);
      allow create: if isValidId(paperId) && isValidPaper(incoming());
      allow update: if isValidId(paperId) && isValidPaper(incoming());
      allow delete: if isValidId(paperId);
    }

    // Examination Date Sheets
    match /datesheets/{dateSheetId} {
      allow read: if isValidId(dateSheetId);
      allow create: if isValidId(dateSheetId) && isValidDateSheet(incoming());
      allow update: if isValidId(dateSheetId) && isValidDateSheet(incoming());
      allow delete: if isValidId(dateSheetId);
    }

    // Student Marksheets & Result Cards
    match /marksheets/{marksheetId} {
      allow read: if isValidId(marksheetId);
      allow create: if isValidId(marksheetId) && isValidMarksheet(incoming());
      allow update: if isValidId(marksheetId) && isValidMarksheet(incoming());
      allow delete: if isValidId(marksheetId);
    }
  }
}
